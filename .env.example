# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from: Supabase Dashboard → Project Settings → API
#
# SUPABASE_URL: Project URL (e.g., https://abcdefghijk.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: Service role key (NOT the anon key)
#
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Database Connection (for Analytics & Direct Queries)
# =============================================================================
# Get from: Supabase Dashboard → Settings → Database → Connection String
# Select the "Session pooler" tab (NOT "Direct connection")
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres
#
# IMPORTANT:
# - Use port 6543 (pooler), not 5432 (direct)
# - Replace [PASSWORD] with your database password
# - URL-encode special characters in password: @ becomes %40, # becomes %23
#
# Example:
# DATABASE_URL=postgresql://postgres.abcdefg:MyP@ss%40word@aws-1-us-west-2.pooler.supabase.com:6543/postgres
#
DATABASE_URL=

# =============================================================================
# Session Secret (for JWT Authentication)
# =============================================================================
# Generate a random 32+ character string
#
# Mac/Linux: openssl rand -base64 32
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#
SESSION_SECRET=

# =============================================================================
# SMTP Email Configuration (Optional - for email features)
# =============================================================================
# For Gmail: You MUST use an App Password, not your regular password
# Setup guide: See SMTP_SETUP_GUIDE.md
#
# To generate Gmail App Password:
# 1. Enable 2-Step Verification at https://myaccount.google.com/security
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below
#
# Note: Email features are optional. App works without SMTP configured.
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# =============================================================================
# Frontend URL (for CORS)
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Rate Limiting (optional)
# =============================================================================
# IPs allowed to set X-Forwarded-For (i.e. the Next.js server that proxies
# form submissions and login). Default: 127.0.0.1,::1 (same host).
# TRUSTED_PROXY_IPS=127.0.0.1,::1
#
# Shared limit storage when running multiple workers (default: in-memory).
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

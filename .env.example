# Supabase REST API (existing, used by other routers)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — REQUIRED for engagement tracking & analytics.
# Get this from Supabase Dashboard → Settings → Database → Connection String → URI
# Format: postgresql://postgres.[ref]:[password]@[host]:6543/postgres
DATABASE_URL=

# Session JWT (must match Next.js SESSION_SECRET)
SESSION_SECRET=

# SMTP for transactional + admin alert emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# Frontend
FRONTEND_URL=http://localhost:3000

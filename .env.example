# Frontend URL for CORS - MUST be set to production domain in production
# Used to restrict API access to authorized frontend only
FRONTEND_URL=http://localhost:3000

# Backend domain for TrustedHost middleware - REQUIRED in production
# Used to prevent host header attacks (e.g., api.example.com)
BACKEND_DOMAIN=localhost:8000

# Frontend environment variables
